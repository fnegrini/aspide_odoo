<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

	<record id="view_company_form" model="ir.ui.view">
		<field name="name">view.company.form</field>
		<field name="model">res.company</field>
		<field name="inherit_id" ref="base.view_company_form" />
		<field name="arch" type="xml">
			<data>
				<xpath expr="//notebook" position="inside">
					<page string="ÁSPIDE" name="aspide" >
						<group>
							<field name="aspide_url"/>
							<field name="aspide_database"/>
							<field name="aspide_user"/>
							<field name="aspide_password" password="True"/>
						</group>
						<group>
							<button name="aspide_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
						</group>
					</page>
				</xpath>
			</data>
		</field>
	</record>

    </data>
</odoo>
