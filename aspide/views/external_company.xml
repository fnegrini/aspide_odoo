<odoo>
  <data>
  
    <!-- Views -->
    <record model="ir.ui.view" id="aspide_external_company_tree">
        <field name="name">aspide.external.company.tree</field>
        <field name="model">aspide.external.company</field>
        <field name="arch" type="xml">
            <list string="External Company">
                <field name="code"/>
                <field name="name"/>
                <field name="timestamp"/>
            </list>
        </field>
     </record>
        
     <record model="ir.ui.view" id="aspide_external_company_form">
        <field name="name">aspide.external.company.form</field>
        <field name="model">aspide.external.company</field>
        <field name="arch" type="xml">
			<form string="External Company">
				<sheet>
					<header>
						<button name="retrieve" type="object" string="Retrieve data" class="oe_highlight" groups="aspide.group_aspide_entity"/>
						<button name="fetch_entity_for_branches" type="object" string="Fetch entities" class="oe_highlight" groups="aspide.group_aspide_entity"/>
						<button name="fetch_regimes" type="object" string="Fetch regimes" class="oe_highlight" groups="aspide.group_aspide_entity"/>
						<button name="partner_search_companies" type="object" string="Search other companies of partners" class="oe_highlight" groups="aspide.group_aspide_entity"/>
						<button name="search_partners_person" type="object" string="Search partners (person)" class="oe_highlight" groups="aspide.group_aspide_entity"/>
					</header>
					<group>
						<field name="timestamp" readonly="1"/>
						<field name="error_message" readonly="1" invisible="not error_message"/>
					</group>
					<group readonly="1">
						<field name="code" required="1" readonly="timestamp"/>
						<field name="name" readonly="1"/>
						<field name="legal_nature_name" readonly="1"/>
					</group>
					<notebook name="aspide_sub">
		            	<page string="Classification">
							<group readonly="1">
								<field name="partner_qualification_name" readonly="1"/>
								<field name="share_capital" readonly="1"/>
								<field name="company_size" readonly="1"/>
								<field name="simple" readonly="1"/>
								<field name="simple_start_date" readonly="1"/>
								<field name="simple_end_date" readonly="1"/>
								<field name="ind_mei" readonly="1"/>
							</group>
						</page>  		                    
			    		<page string="Entities">
					        <group>
					            <field name="branches" widget="one2many_list" colspan="2" nolabel="1" readonly="1"/>
						    </group>
			    		</page>
			    		<page string="Regimes">
					        <group>
								<field name="regime_fetched" readonly="1"/>
						    </group>
					        <group>
					            <field name="regimes" widget="one2many_list" colspan="2" nolabel="1" readonly="1"/>
						    </group>
			    		</page>        
			    		<page string="Partners">
					        <group>
					            <field name="partners" widget="one2many_list" colspan="2" nolabel="1" readonly="1"/>
						    </group>
			    		</page>        
			    		<page string="Partner companies">
					        <group>
								<field name="partner_companies_fetched" readonly="1"/>
						    </group>							
					        <group>
					            <field name="partner_companies" widget="one2many_list" colspan="2" nolabel="1" readonly="1"/>
						    </group>
			    		</page>
			    		<page string="Partners (Person)">
					        <group>
								<field name="partners_person_fetched" readonly="1"/>
						    </group>
					        <group>
					            <field name="partners_person" widget="one2many_list" colspan="2" nolabel="1" readonly="1"/>
						    </group>
			    		</page>  						
					</notebook>
				</sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="aspide_external_company_branch_tree">
        <field name="name">aspide.external.company.branch.tree</field>
        <field name="model">aspide.external.company.branch</field>
        <field name="arch" type="xml">
            <list string="External Company - Entity">
                <field name="code" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="type" readonly="1"/>
                <field name="situation" readonly="1"/>
				<field name="situation_date" readonly="1"/>
				<field name="cnae_name" readonly="1"/>
				<field name="entity" readonly="1" options="{'no_create_edit': True, 'no_quick_create': True}"/>
            </list>
        </field>
    </record>
     

    <record model="ir.ui.view" id="aspide_external_company_branch_form">
        <field name="name">aspide.external.company.branch.form</field>
        <field name="model">aspide.external.company.branch</field>
        <field name="arch" type="xml">
			<form string="External Company - Entity">
				<sheet>
					<header>
						<button name="fetch_entity" type="object" string="Fetch Entity" class="oe_highlight" groups="aspide.group_aspide_entity"/>
					</header>				
					<group>
					    <field name="external_company" readonly="1" options="{'no_create_edit': True, 'no_quick_create': True}"/>
						<field name="code" readonly="1"/>
						<field name="name" readonly="1"/>
						<field name="type" readonly="1"/>
						<field name="founded" readonly="1"/>
						<field name="situation" readonly="1"/>
						<field name="situation_date" readonly="1"/>
						<field name="cnae_name" readonly="1"/>
						<field name="entity" readonly="1" options="{'no_create_edit': True, 'no_quick_create': True}"/>
					</group>
				</sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="aspide_external_company_partner_tree">
        <field name="name">aspide.external.company.partner.tree</field>
        <field name="model">aspide.external.company.partner</field>
        <field name="arch" type="xml">
            <list string="External Company - Partner">
            	<field name="type" readonly="1"/>
                <field name="code" readonly="1"/>
                <field name="name" readonly="1"/>
				<field name="qualification_name" readonly="1"/>
            </list>
        </field>
	</record>

     <record model="ir.ui.view" id="aspide_external_company_partner_form">
        <field name="name">aspide.external.company.partner.form</field>
        <field name="model">aspide.external.company.partner</field>
        <field name="arch" type="xml">
			<form string="External Company - Partner">
				<sheet>
					<header>
						<!-- <button name="search_companies" type="object" string="Search other companies" class="oe_highlight" groups="aspide.group_aspide_entity"/> -->
					</header>				
					<group>
						<field name="external_company" readonly="1" options="{'no_create_edit': True, 'no_quick_create': True}"/>
						<field name="type" readonly="1"/>
						<field name="code" readonly="1"/>
						<field name="name" readonly="1"/>
					</group>
					<notebook name="aspide_sub">
		            	<page string="Classification">
							<group>
								<field name="qualification_name" readonly="1"/>
								<field name="agegroup_name" readonly="1"/>
								<field name="share_percent" readonly="1"/>
								<field name="start_date" readonly="1"/>
							</group>
						</page>  		                    
		            	<page string="Foreign Address">
							<group>
								<field name="country_code" readonly="1"/>
								<field name="country_name" readonly="1"/>
								<field name="country_id" readonly="1" options="{'no_create_edit': True, 'no_quick_create': True}"/>
							</group>
						</page>  		                    
		            	<page string="Legal Agent">
							<group>
								<field name="legal_agent_code" readonly="1"/>
								<field name="legal_agent_name" readonly="1"/>
								<field name="legal_agent_qualification_name" readonly="1"/>
							</group>
						</page>          
		            	<page string="Other companies">
					        <group>
					            <field name="partner_companies" widget="one2many_list" colspan="2" nolabel="1" readonly="1"/>
						    </group>
						</page>          
					</notebook>
				</sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="aspide_external_company_partner_company_tree">
        <field name="name">aspide.external.company.partner.company.tree</field>
        <field name="model">aspide.external.company.partner.company</field>
        <field name="arch" type="xml">
            <list string="External Company - Partner company">
				<field name="code" readonly="1"/>
				<field name="name" readonly="1"/>
				<field name="qualification_name" readonly="1"/>
                <field name="start_date" readonly="1"/>
				<field name="share_percent" readonly="1"/>
            </list>
        </field>
	</record>

     <record model="ir.ui.view" id="aspide_external_company_partner_company_form">
        <field name="name">aspide.external.company.partner.company.form</field>
        <field name="model">aspide.external.company.partner.company</field>
        <field name="arch" type="xml">
			<form string="External Company - Partner">
				<sheet>
					<header>
						<button name="fetch_company" type="object" string="Fetch Company" class="oe_highlight" groups="aspide.group_aspide_entity"/>
					</header>						
					<group>
						<field name="partner" readonly="1" options="{'no_create_edit': True, 'no_quick_create': True}"/>
						<field name="code" readonly="1"/>
						<field name="name" readonly="1"/>
						<field name="external_company" readonly="1" invisible="not external_company" options="{'no_create_edit': True, 'no_quick_create': True}"/>
						<field name="qualification_name" readonly="1"/>
						<field name="start_date" readonly="1"/>
						<field name="share_percent" readonly="1"/>
					</group>
				</sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="aspide_external_company_regime_tree">
        <field name="name">aspide.external.company.regime.tree</field>
        <field name="model">aspide.external.company.regime</field>
        <field name="arch" type="xml">
            <list string="External Company - Regime">
                <field name="year" readonly="1"/>
                <field name="scp_code" readonly="1"/>
                <field name="regime" readonly="1"/>
                <field name="bookkeeping_count" readonly="1"/>
            </list>
        </field>
    </record>
     

    <record model="ir.ui.view" id="aspide_external_company_regime_form">
        <field name="name">aspide.external.company.regime.form</field>
        <field name="model">aspide.external.company.regime</field>
        <field name="arch" type="xml">
			<form string="External Company - Regime">
				<sheet>
					<group>
						<field name="external_company" readonly="1" options="{'no_create_edit': True, 'no_quick_create': True}"/>
						<field name="year" readonly="1"/>
						<field name="scp_code" readonly="1"/>
						<field name="regime" readonly="1"/>
						<field name="bookkeeping_count" readonly="1"/>
					</group>
				</sheet>
            </form>
        </field>
    </record>


	<record model="ir.ui.view" id="aspide_external_company_partner_person_tree">
        <field name="name">aspide.external.company.partner.person.tree</field>
        <field name="model">aspide.external.company.partner.person</field>
        <field name="arch" type="xml">
            <list string="External Company - Partner (Person)">
                <field name="level" readonly="1"/>
                <field name="partner_code" readonly="1"/>
				<field name="partner_name" readonly="1"/>
                <field name="partner_external_company_code" readonly="1"/>
				<field name="partner_external_company_name" readonly="1"/>
            </list>
        </field>
    </record>
     

    <record model="ir.ui.view" id="aspide_external_company_partner_person_form">
        <field name="name">aspide.external.company.partner.person.form</field>
        <field name="model">aspide.external.company.partner.person</field>
        <field name="arch" type="xml">
			<form string="External Company - Partner (Person)">
				<sheet>
					<header>
						<button name="fetch_partner_company" type="object" string="Fetch Person Company" class="oe_highlight" groups="aspide.group_aspide_entity"/>
					</header>					
					<group>
						<field name="external_company" readonly="1" options="{'no_create_edit': True, 'no_quick_create': True}"/>
						<field name="level" readonly="1"/>
						<field name="partner_code" readonly="1"/>
						<field name="partner_name" readonly="1"/>
						<field name="partner_external_company_code" readonly="1"/>
						<field name="partner_external_company_name" readonly="1"/>
						<field name="partner_external_company" readonly="1" invisible="not partner_external_company" options="{'no_create_edit': True, 'no_quick_create': True}"/>
					</group>
				</sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="aspide_external_company_company_tree">
        <field name="name">aspide.external.company.company.tree</field>
        <field name="model">aspide.external.company.company</field>
        <field name="arch" type="xml">
            <list string="External Company - Partner Company">
                <field name="code" readonly="1"/>
                <field name="name" readonly="1"/>
            </list>
        </field>
    </record>
     

    <record model="ir.ui.view" id="aspide_external_company_company_form">
        <field name="name">aspide.external.company.company.form</field>
        <field name="model">aspide.external.company.company</field>
        <field name="arch" type="xml">
			<form string="External Company - Partner Company">
				<sheet>
					<header>
						<button name="fetch_company" type="object" string="Fetch Partner Company" class="oe_highlight" groups="aspide.group_aspide_entity"/>
					</header>				
					<group>
					    <field name="external_company" readonly="1" options="{'no_create_edit': True, 'no_quick_create': True}"/>
						<field name="code" readonly="1"/>
						<field name="name" readonly="1"/>
						<field name="partner_external_company" readonly="1" invisible="not partner_external_company" options="{'no_create_edit': True, 'no_quick_create': True}"/>
					</group>
				</sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    
    <record model="ir.actions.act_window" id="aspide_external_company_action">
        <field name="name">External Company</field>
        <field name="res_model">aspide.external.company</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create a new External Company
            </p>
        </field>
    </record>
          
    <!-- Menu Item -->
    <menuitem name="External Company" 
		id="menu_aspide_external_company" 
		parent="menu_aspide_main"
		action="aspide_external_company_action"
		groups="group_aspide_entity,group_aspide_entity_reader"
		sequence="200"/>

 	<!-- Rule -->
    <record model="ir.rule" id="aspide_external_company_rule">
        <field name="name">Multicompany Rule</field>
        <field name="model_id" ref="model_aspide_external_company"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in', company_ids)]</field>
    </record>
  </data>
</odoo>