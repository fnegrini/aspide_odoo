        <field name="name">Search other companies of partners</field>
        <field name="model_id" ref="model_aspide_external_company"/>
        <field name="binding_model_id" ref="model_aspide_external_company"/>
        <field name="state">code</field>
        <field name="code">records.action_partner_search_companies()</field>
    </record>

	  <record id="aspide_external_company_search_partners_person" model="ir.actions.server">
        <field name="name">Search partners (person)</field>
        <field name="model_id" ref="model_aspide_external_company"/>
        <field name="binding_model_id" ref="model_aspide_external_company"/>
        <field name="state">code</field>
        <field name="code">records.action_search_partners_person()</field>
    </record>

